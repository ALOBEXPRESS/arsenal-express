# SyncExpress — variáveis de ambiente (Vercel → Settings → Environment Variables)
# Ambas são públicas por design (vão para o navegador). A segurança vem do RLS no Supabase.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase → Project Settings → API → "anon public" key (NUNCA use a service_role aqui)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# R2 (server-only; do not prefix with NEXT_PUBLIC_)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional administrator fallback for captions. Personal keys are configured in the app
# and encrypted in Supabase Vault. Other users must configure their own OpenAI key.
# Server only: never NEXT_PUBLIC_.
OPENAI_API_KEY=

# Server-side credential management (also used by R2 storage accounting).
SUPABASE_SERVICE_ROLE_KEY=
